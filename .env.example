# ============================================================================
# ReelAgent 配置示例（云端产品版）
#
# 用法：
#     cp .env.example .env      # 然后按需填写
#
# 命名规则（全部由 reelagent_cloud/config.py 定义，改名前请先看那份代码）：
#     * 统一前缀 REEL_
#     * 嵌套字段用双下划线：REEL_DATABASE__URL → settings.database.url
#     * 大小写不敏感；`.env` 与 `.env.local` 都会被读取（后者覆盖前者）
#     * 列表类字段必须写 JSON：REEL_SECURITY__ALLOWED_HOSTS=["a.com","b.com"]
#
# 两种阅读方式：
#     A. 只想本机跑起来    → 一份都不改，直接 `make dev`（默认 dev + SQLite + 本地存储）
#     B. 要部署到服务器    → 从 .env.production.example 开始，那份带生产校验说明
#
# 图例：【必填】= 生产环境缺失会导致启动失败；【可选】= 有合理默认值或可降级
# ============================================================================


# ============================================================================
# 一、产品标识
# ============================================================================

# 【必填（生产）】运行环境：dev | staging | prod
# prod 会触发启动期硬校验（HTTPS、非 SQLite、显式主机名、视频供应商 Key），
# 任何一条不满足就直接拒绝启动——宁可起不来，也不要带病上线。
REEL_ENV=dev

# 【可选】产品名，用于页面标题、API 文档与邮件落款
REEL_PRODUCT_NAME=ReelAgent

# 【必填（生产）】对外访问地址，用于生成回调链接、分享链接与 OpenAPI servers。
# 生产环境必须是 https 开头；未申请域名时先留 localhost。
REEL_BASE_URL=http://localhost:8000

# 【可选】支持邮箱，展示在落地页与 API 文档联系信息里
REEL_SUPPORT_EMAIL=support@reelagent.local

# 【可选】API 文档路径，默认 /docs
REEL_DOCS_URL=/docs


# ============================================================================
# 二、数据库（PostgreSQL）
# ============================================================================
# 开发可用 SQLite，生产**必须**是 Postgres：
#   SQLite:     sqlite+aiosqlite:///./workspace/reelagent.db
#   Postgres:   postgresql+asyncpg://用户:口令@主机:5432/库名
# 注意驱动名必须带 +asyncpg（本项目全程 async SQLAlchemy）。
# 用 docker-compose 部署时，本变量会被 compose 依据 POSTGRES_* 自动推导并覆盖，
# 不需要（也不应该）在这里再抄一遍带口令的 URL。

# 【必填（生产）】数据库连接串
REEL_DATABASE__URL=sqlite+aiosqlite:///./workspace/reelagent.db

# 【可选】是否打印 SQL（本地排查 N+1 时临时开，线上务必关）
REEL_DATABASE__ECHO=false

# 【可选】连接池。`worker` 与多副本 `api` 的总连接数不应超过 Postgres 的
# max_connections（默认 100），否则会出现"连接被拒"的雪崩。
REEL_DATABASE__POOL_SIZE=10
REEL_DATABASE__MAX_OVERFLOW=20
REEL_DATABASE__POOL_TIMEOUT=30
# 回收秒数：要小于云数据库/负载均衡的空闲连接回收时间（常见 1800s）
REEL_DATABASE__POOL_RECYCLE=1800
# 取连接前先探活，能自动跳过被中间设备掐断的死连接
REEL_DATABASE__POOL_PRE_PING=true
# 单条 SQL 的服务端超时（毫秒），防止慢查询把连接池占死
REEL_DATABASE__STATEMENT_TIMEOUT_MS=30000


# ============================================================================
# 三、Redis（限流与缓存）
# ============================================================================
# Redis 是**可选**依赖：不启用时限流退化为进程内实现，功能不受影响。
# 但多副本部署时**必须**启用，否则每个副本各算一份限流额度，等于没限。

# 【可选】是否启用 Redis
REEL_REDIS__ENABLED=false

# 【可选】带口令的连接串（示例：redis://:口令@redis:6379/0）
REEL_REDIS__URL=redis://localhost:6379/0

# 【可选】单次命令超时与连接池上限
REEL_REDIS__SOCKET_TIMEOUT=2.0
REEL_REDIS__MAX_CONNECTIONS=32


# ============================================================================
# 四、对象存储（产物放哪）
# ============================================================================
# backend=local：文件落在磁盘，由 API 以鉴权路由提供下载（自托管友好，默认）
# backend=s3   ：S3 兼容协议，通吃 AWS S3 / 阿里云 OSS / Cloudflare R2 / MinIO
# 注意：local 模式下 **api 与 worker 必须挂载同一个卷**，否则 worker 写好的
# 成片 api 读不到（docker-compose.yml 里的 artifacts 卷就是干这个的）。

# 【可选】local | s3
REEL_STORAGE__BACKEND=local

# 【可选】local 后端的存储根目录（容器内建议 /app/workspace/storage）
REEL_STORAGE__LOCAL_DIR=./workspace/storage

# 【必填（当 BACKEND=s3 时）】桶名。config.py 会在 backend=s3 且桶名为空时
# 直接报错，避免上线后才发现"存不进去"。
REEL_STORAGE__S3_BUCKET=
# 【可选】区域；用 R2 / MinIO 时可留空
REEL_STORAGE__S3_REGION=
# 【可选】自建 S3 兼容服务的端点，例如 MinIO：http://minio:9000
REEL_STORAGE__S3_ENDPOINT_URL=
# 【可选】访问密钥。留空则回退到实例角色/IAM（云上更推荐这种做法）
REEL_STORAGE__S3_ACCESS_KEY_ID=
REEL_STORAGE__S3_SECRET_ACCESS_KEY=
# 【可选】CDN 或公开域名前缀，配置后下载走直链而非后端中转
REEL_STORAGE__S3_PUBLIC_BASE_URL=
# 【可选】预签名 URL 有效期（秒）
REEL_STORAGE__PRESIGN_TTL_SECONDS=3600
# 【可选】单文件上传上限（MB），防止有人拿接口当网盘
REEL_STORAGE__MAX_UPLOAD_MB=32


# ============================================================================
# 五、安全（生产环境的重点检查项）
# ============================================================================

# 【必填（生产）】会话签名 / CSRF 密钥。生产缺失会直接启动失败。
# 生成方法（任选其一，长度足够即可）：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#     openssl rand -base64 48
# 轮换会导致所有已登录会话失效，属于预期行为（也是"踢下线"的手段）。
REEL_SECURITY__SECRET_KEY=

# 【可选】API Key 的 pepper。留空时开发环境自动派生（secret_key + ":apikey"）；
# 生产建议单独配置，这样可以只轮换 pepper 而不影响用户登录态。
REEL_SECURITY__API_KEY_PEPPER=

# 【可选】Cookie 名称
REEL_SECURITY__SESSION_COOKIE=reelagent_session
REEL_SECURITY__CSRF_COOKIE=reelagent_csrf
# 【可选】CSRF 校验读取的请求头名
REEL_SECURITY__CSRF_HEADER=x-csrf-token
# 【可选】会话有效期（秒），默认 14 天
REEL_SECURITY__SESSION_MAX_AGE_SECONDS=1209600

# 【必填（生产）】是否只允许 HTTPS。生产必须为 true，否则启动校验不通过。
REEL_SECURITY__HTTPS_ONLY=false

# 【必填（生产）】允许的 Host 列表（JSON 数组）。
# 生产环境不允许保留 "*"，必须显式列出域名，否则启动失败——这是防 Host 头攻击的第一道闸。
# 例：REEL_SECURITY__ALLOWED_HOSTS=["reelagent.example.com","www.reelagent.example.com"]
REEL_SECURITY__ALLOWED_HOSTS=["*"]

# 【可选】登录失败限流（按账号/IP）
REEL_SECURITY__LOGIN_MAX_ATTEMPTS=10
REEL_SECURITY__LOGIN_WINDOW_SECONDS=300
# 【可选】密码最短长度
REEL_SECURITY__MIN_PASSWORD_LENGTH=10
# 【可选】是否开放公开注册；私有部署建议 false，改为邀请码
REEL_SECURITY__ALLOW_SIGNUP=true
# 【可选】邀请码；留空则不校验邀请码
REEL_SECURITY__SIGNUP_INVITE_CODE=


# ============================================================================
# 六、限流
# ============================================================================
# 四类额度互相独立。开启 Redis 后是全局共享计数，关闭则是单进程计数。

# 【可选】总开关
REEL_RATE_LIMIT__ENABLED=true
# 【可选】匿名（按 IP）每分钟
REEL_RATE_LIMIT__ANONYMOUS_PER_MINUTE=30
# 【可选】登录用户（按 user）每分钟
REEL_RATE_LIMIT__USER_PER_MINUTE=240
# 【可选】建项目（按组织）每小时——这是花钱最多的接口，额度要给紧
REEL_RATE_LIMIT__PROJECT_CREATES_PER_HOUR=60
# 【可选】单个 API Key 每分钟
REEL_RATE_LIMIT__API_KEY_PER_MINUTE=300


# ============================================================================
# 七、Worker（任务执行进程）
# ============================================================================
# 这部分直接决定"生成成片的吞吐与钱"。改动前请先读 workers/runner.py。

# 【可选】同时执行的任务数。注意：这里的并发 × 下面镜头并发 = 同时在跑的供应商请求数
REEL_WORKER__CONCURRENCY=2
# 【可选】单个任务内并发生成的镜头数
REEL_WORKER__SHOT_CONCURRENCY=3
# 【可选】无任务时的轮询间隔（秒）；调大省数据库，调小降延迟
REEL_WORKER__POLL_INTERVAL_SECONDS=2.0
# 【可选】任务租约时长（秒）。超过未续约视为 worker 崩溃，任务可被重新领取。
# 必须显著大于心跳间隔；调太小会让慢任务被"抢走"从而重复扣费。
REEL_WORKER__LEASE_SECONDS=900
# 【可选】心跳间隔（秒），负责续约 + 读取用户的取消请求
REEL_WORKER__HEARTBEAT_SECONDS=20
# 【可选】单任务最长执行时间（秒）
REEL_WORKER__JOB_TIMEOUT_SECONDS=3600
# 【可选】失败重试次数
REEL_WORKER__MAX_ATTEMPTS=3
# 【可选】优雅停机宽限期（秒）：收到 SIGTERM 后停止领新任务，把在跑的做完。
# ⚠ 容器编排里的 stop_grace_period / terminationGracePeriodSeconds
#   必须**大于**这个值（compose 用的是 120s），否则收尾阶段仍会被 SIGKILL。
REEL_WORKER__SHUTDOWN_GRACE_SECONDS=60


# ============================================================================
# 八、可观测性（日志 / 指标 / Sentry）
# ============================================================================

# 【可选】DEBUG | INFO | WARNING | ERROR
REEL_OBSERVABILITY__LOG_LEVEL=INFO
# 【可选】json = 生产采集友好；console = 本地人眼友好
REEL_OBSERVABILITY__LOG_FORMAT=console
# 【可选】是否暴露 Prometheus 指标端点
REEL_OBSERVABILITY__METRICS_ENABLED=true
# 【可选】指标路径（与 api/routes/system.py 的 /metrics 一致）
REEL_OBSERVABILITY__METRICS_PATH=/metrics
# 【可选】慢请求阈值（毫秒），超过会打点，便于告警
REEL_OBSERVABILITY__SLOW_REQUEST_MS=3000
# 【可选】Sentry DSN；留空则不启用（需要额外安装 sentry-sdk，见 pyproject 的 sentry extra）
REEL_OBSERVABILITY__SENTRY_DSN=


# ============================================================================
# 九、计费（Stripe）
# ============================================================================
# 未启用时产品降级为"额度模式"：注册即赠额度，不可充值。
# 启用后必须同时配置 secret_key（否则配置校验直接报错退出）。

# 【可选】是否启用 Stripe 计费
REEL_BILLING__ENABLED=false
# 【必填（当 BILLING__ENABLED=true 时）】Stripe 密钥；生产用 sk_live_ 开头
REEL_BILLING__SECRET_KEY=
# 【必填（当启用 Webhook 时）】Webhook 签名密钥（whsec_ 开头），
# 用于校验 POST /webhooks/stripe 的请求确实来自 Stripe，而不是伪造的充值通知。
REEL_BILLING__WEBHOOK_SECRET=
# 【可选】前端可发布的公钥（pk_ 开头），不敏感
REEL_BILLING__PUBLISHABLE_KEY=
# 【可选】计价货币：cny | usd
REEL_BILLING__CURRENCY=cny
# 【可选】Stripe Price ID 与套餐的对应关系
REEL_BILLING__PRICE_STARTER=
REEL_BILLING__PRICE_PRO=
REEL_BILLING__PRICE_STUDIO=
# 【可选】供应商成本 → 用户扣费的加价倍率（毛利就靠这个参数）
REEL_BILLING__MARKUP_MULTIPLIER=3.0
# 【可选】多少"点数"等于 1 美元
REEL_BILLING__CREDITS_PER_USD=100


# ============================================================================
# 十、供应商（LLM / 图像 / 视频 / TTS）
# ============================================================================
# 这些 Key 是产品的"生产资料"：没有视频 Key 就产不出成片，
# 生产环境校验会直接拦截（REEL_PROVIDERS__VIDEO__API_KEY 必填）。
#
# 说明：云端产品的引擎配置由 pipeline.py 从**本组变量**组装，
# 而不是读引擎层遗留的扁平变量（REEL_LLM_API_KEY 等）——
# 那些只对独立运行 `reelagent` 引擎 CLI 有效，详见文件末尾的附录。
#
# 每个供应商都支持同一组子字段：
#   ENABLED / PROVIDER / MODEL / API_KEY / BASE_URL / TIMEOUT_SECONDS /
#   MAX_CONCURRENCY / MAX_RETRIES / CIRCUIT_BREAKER_THRESHOLD / CIRCUIT_BREAKER_RESET_SECONDS

# 【可选】是否允许用户在控制台填自己的 Key（BYOK），平台 Key 仅作兜底
REEL_PROVIDERS__ALLOW_BYOK=true

# ---------- LLM（负责剧本、分镜、提示词）----------
# 兼容 OpenAI 协议的都能用：DeepSeek / 通义 / 火山方舟 / OpenAI
REEL_PROVIDERS__LLM__ENABLED=false
REEL_PROVIDERS__LLM__PROVIDER=deepseek
REEL_PROVIDERS__LLM__MODEL=deepseek-chat
REEL_PROVIDERS__LLM__API_KEY=
REEL_PROVIDERS__LLM__BASE_URL=https://api.deepseek.com/v1
REEL_PROVIDERS__LLM__TIMEOUT_SECONDS=180
REEL_PROVIDERS__LLM__MAX_CONCURRENCY=4
REEL_PROVIDERS__LLM__MAX_RETRIES=3
REEL_PROVIDERS__LLM__CIRCUIT_BREAKER_THRESHOLD=5
REEL_PROVIDERS__LLM__CIRCUIT_BREAKER_RESET_SECONDS=60

# ---------- 图像（关键帧 / 分镜首图）----------
# 可选：ark（火山方舟 Seedream）| dashscope（阿里万相）| openai
REEL_PROVIDERS__IMAGE__ENABLED=false
REEL_PROVIDERS__IMAGE__PROVIDER=ark
REEL_PROVIDERS__IMAGE__MODEL=doubao-seedream-4-0-250828
REEL_PROVIDERS__IMAGE__API_KEY=
REEL_PROVIDERS__IMAGE__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
REEL_PROVIDERS__IMAGE__TIMEOUT_SECONDS=180
REEL_PROVIDERS__IMAGE__MAX_CONCURRENCY=4
REEL_PROVIDERS__IMAGE__MAX_RETRIES=3
REEL_PROVIDERS__IMAGE__CIRCUIT_BREAKER_THRESHOLD=5
REEL_PROVIDERS__IMAGE__CIRCUIT_BREAKER_RESET_SECONDS=60

# ---------- 视频（真正的成片来源，**生产必填**）----------
# 可选：ark（Seedance）| dashscope（Wan）| kling（可灵）
REEL_PROVIDERS__VIDEO__ENABLED=false
REEL_PROVIDERS__VIDEO__PROVIDER=ark
REEL_PROVIDERS__VIDEO__MODEL=doubao-seedance-1-0-pro-250528
REEL_PROVIDERS__VIDEO__API_KEY=
REEL_PROVIDERS__VIDEO__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视频生成慢，超时给足；并发压低一些，避免触发厂商限流导致整单失败
REEL_PROVIDERS__VIDEO__TIMEOUT_SECONDS=300
REEL_PROVIDERS__VIDEO__MAX_CONCURRENCY=2
REEL_PROVIDERS__VIDEO__MAX_RETRIES=3
REEL_PROVIDERS__VIDEO__CIRCUIT_BREAKER_THRESHOLD=5
REEL_PROVIDERS__VIDEO__CIRCUIT_BREAKER_RESET_SECONDS=60

# ---------- TTS（配音）----------
# 可选：dashscope（Qwen3-TTS）| openai
REEL_PROVIDERS__TTS__ENABLED=false
REEL_PROVIDERS__TTS__PROVIDER=dashscope
REEL_PROVIDERS__TTS__MODEL=qwen3-tts-flash
REEL_PROVIDERS__TTS__API_KEY=
REEL_PROVIDERS__TTS__BASE_URL=https://dashscope.aliyuncs.com/api/v1
REEL_PROVIDERS__TTS__TIMEOUT_SECONDS=180
REEL_PROVIDERS__TTS__MAX_CONCURRENCY=4
REEL_PROVIDERS__TTS__MAX_RETRIES=3
REEL_PROVIDERS__TTS__CIRCUIT_BREAKER_THRESHOLD=5
REEL_PROVIDERS__TTS__CIRCUIT_BREAKER_RESET_SECONDS=60


# ============================================================================
# 十一、邮件（可选）
# ============================================================================
# 未配置 SMTP 时，邮件会被写入数据库 outbox 表并记录日志（开发友好），
# 不会阻塞注册流程。

# 【可选】是否启用真实发送
REEL_EMAIL__ENABLED=false
REEL_EMAIL__HOST=
REEL_EMAIL__PORT=587
REEL_EMAIL__USERNAME=
REEL_EMAIL__PASSWORD=
REEL_EMAIL__USE_TLS=true
REEL_EMAIL__FROM_ADDRESS="ReelAgent <no-reply@reelagent.local>"


# ============================================================================
# 十二、引擎参数（可选）
# ============================================================================

# 【可选】默认风格预设
REEL_STYLE=cinematic
# 【可选】画幅比例，默认竖屏 9:16
REEL_ASPECT_RATIO=9:16
# 【可选】单个项目最多几个镜头
REEL_MAX_SHOTS_PER_PROJECT=12
# 【可选】最多几张基准图
REEL_MAX_BASE_IMAGES=6
# 【可选】单项目预算上限（美元），超预算会自动降级到更便宜的模型
REEL_JOB_BUDGET_USD=2.0
# 【可选】数据根目录（产物、引擎临时工作区都在它下面）。
# 容器内建议 /app/workspace，并挂一个持久卷，否则重启即丢产物。
REEL_WORKSPACE_DIR=./workspace


# ============================================================================
# 十三、仅 docker compose 使用的变量（不属于 config.py）
# ============================================================================
# 这些变量由 docker-compose.yml 读取，用于初始化 Postgres / Redis 容器，
# 并**推导**出 api/worker 的 REEL_DATABASE__URL 与 REEL_REDIS__URL。
# 好处是口令只写一处，不会出现"postgres 容器口令是 A、应用连的是 B"的经典故障。
# 生产环境请务必改成强口令，参数留空时 compose 会直接报错退出（这是有意的）。

# 【docker compose 必填】Postgres 初始化参数
POSTGRES_USER=reelagent
POSTGRES_PASSWORD=reelagent
POSTGRES_DB=reelagent

# 【docker compose 必填】Redis 口令
REDIS_PASSWORD=reelagent-dev

# 【docker compose 可选】其他
# REEL_BIND_ADDR=127.0.0.1        # api 端口绑定的网卡，默认只绑本机
# REEL_HTTP_PORT=8000             # api 对外端口
# REEL_IMAGE=reelagent            # 镜像名
# REEL_IMAGE_TAG=local            # 镜像标签
# REDIS_MAXMEMORY=256mb
# MINIO_ROOT_USER=reelagent       # 仅在 docker-compose.dev.yml 的 s3 profile 下使用
# MINIO_ROOT_PASSWORD=reelagent-dev


# ============================================================================
# 附录：引擎层遗留的扁平变量（云端产品**不读**这些）
# ============================================================================
# 下列变量只对"独立运行引擎 CLI"（reelagent / python -m reelagent）有效。
# 云端产品在 services/pipeline.py 里用 REEL_PROVIDERS__* 显式组装引擎配置，
# 所以在这里填 REEL_LLM_API_KEY 是**不会生效**的——这是最容易踩的坑，特此注明。
#
# REEL_MODE=mock              # mock 离线演示 / live 调真实供应商
# REEL_WORKSPACE=workspace
# REEL_BUDGET_USD=2.00
# REEL_CONTEXT_BUDGET=24000
# REEL_MAX_CONCURRENCY=3
# REEL_MAX_ATTEMPTS=3
# REEL_LLM_BASE_URL=https://api.deepseek.com/v1
# REEL_LLM_API_KEY=
# REEL_LLM_MODEL=deepseek-chat
# REEL_LLM_JUDGE_MODEL=
# REEL_IMAGE_PROVIDER=ark
# REEL_IMAGE_MODEL=doubao-seedream-4-0-250828
