# ============================================================================
# 运行产物
# ============================================================================
workspace/
runs/
out/
*.gif
*.mp4
*.wav

# 数据库文件（SQLite 是运行期产物，绝不能进版本库）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 测试临时工作区（放在仓库内是为了避开只读系统盘，但不该提交）
tests/_tmp/

# ============================================================================
# 配置与密钥
# ============================================================================
# .env 里是本机真实凭据。示例文件（.env.example / .env.production.example）
# 不含真实值，需要提交，因此只用精确匹配而不是 .env* 通配。
.env
.env.local
.env.*.local
.pylibs/
.tmp/

# ============================================================================
# 编辑器与系统
# ============================================================================
.idea/
.vscode/
.DS_Store

# ============================================================================
# pip / pytest 在工作区留下的临时目录
# ============================================================================
pip-build-env-*/
pip-build-tracker-*/
pip-install-*/
pip-modern-metadata-*/
pip-ephem-wheel-cache-*/
pip-unpack-*/
pytest-cache-files-*/

# ============================================================================
# 例外：文档里的演示素材要提交
# ----------------------------------------------------------------------------
# README 直接引用了 demo.gif / demo_storyboard.png，被上面的 *.gif 误伤
# 会导致克隆下来后图片显示不出来。文档目录下的静态资源一律放行。
# ============================================================================
!docs/**/*.gif
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.svg

# ----------------------------------------------------------------------------
# 例外：落地页首屏的演示视频要提交
# ----------------------------------------------------------------------------
# 上面的 *.mp4 是为了拦住引擎跑出来的成片与镜头片段（动辄几十 MB、且是运行时
# 产物），但落地页首屏那个 1.3 MB 的演示视频是**源码资产**，不进仓库会导致
# 克隆下来首屏 404。
#
# 踩过的坑：这个文件明明已经 git add 过，却被 *.mp4 静默忽略，commit 里只剩
# 封面图 poster——直到线上 curl 出 404、且 bundle 体积对不上（0.15MB vs 1.3MB）
# 才被发现。凡是在 .gitignore 里加通配规则，都要同时想清楚"有没有反例"。
!reelagent_cloud/web/static/video/*.mp4
