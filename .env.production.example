# ============================================================================
# ReelAgent 生产环境配置模板
#
#     cp .env.production.example .env
#     然后搜索所有 CHANGE_ME，逐个替换成真实值（共 9 处，全部标了 ⚠）
#
# 这份文件的目标是"照抄即可上线"，因此：
#   * 每一项都写了生产取值与理由，不写"自己看着办"；
#   * 只列生产真正需要/建议调的东西，完整变量清单见 .env.example；
#   * 末尾附上"启动校验清单"——服务启动时会逐条检查，不满足就拒绝启动。
# ============================================================================


# ============================================================================
# 一、必改项（不改则启动失败，或上线即出事故）
# ============================================================================

# ⚠ CHANGE_ME ①：必须是 prod，否则下面所有生产校验都不会生效
REEL_ENV=prod

# ⚠ CHANGE_ME ②：换成你的真实域名（必须是 https，生产校验会检查前缀）
REEL_BASE_URL=https://reelagent.example.com

# ⚠ CHANGE_ME ③：会话签名密钥。**每个环境一份，绝不共用，绝不入库**
# 生成方法：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   # 或者
#     openssl rand -base64 48
#   # 或者（本地有 uv 时）
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# 轮换效果：所有已登录会话立即失效（这是预期行为，也是应急踢下线的手段）。
REEL_SECURITY__SECRET_KEY=CHANGE_ME_用上面的命令生成48字节随机串

# ⚠ CHANGE_ME ④：API Key 的 pepper。与 secret_key 分开，便于独立轮换。
# 生成方式同上。留空则回退为 secret_key + ":apikey"，功能可用但无法单独轮换。
REEL_SECURITY__API_KEY_PEPPER=CHANGE_ME_另一个独立的48字节随机串

# ⚠ CHANGE_ME ⑤：只允许 HTTPS。生产校验要求必须为 true。
# 注意：它管的是 Cookie 的 Secure 属性与跳转行为；真正的 TLS 由反向代理终止。
REEL_SECURITY__HTTPS_ONLY=true

# ⚠ CHANGE_ME ⑥：允许的 Host 列表（JSON 数组，**不能**含 "*"）。
# 生产校验会拒绝通配符——这是防 Host 头攻击/缓存投毒的第一道闸。
# 用 IP 直连调试时把 IP 也加进去，调试完删掉。
REEL_SECURITY__ALLOWED_HOSTS=["reelagent.example.com","www.reelagent.example.com"]

# ⚠ CHANGE_ME ⑦：视频供应商 Key。生产校验会检查它是否存在，
# 没有 Key 就产不出成片，产品等于空壳，所以直接拦在启动前。
REEL_PROVIDERS__VIDEO__API_KEY=CHANGE_ME_你的视频供应商Key

# ⚠ CHANGE_ME ⑧ / ⑨：数据库口令与 Redis 口令（见文末"Compose 变量"一节）。
# 这两项被 docker-compose.yml 用来初始化容器，并推导出应用的连接串。


# ============================================================================
# 二、数据库（生产必须是 Postgres）
# ============================================================================
# 生产校验明确拒绝 SQLite（单写入者 + 无并发控制，撑不住 worker 的租约抢占）。
#
# 用 docker compose 时本项**不需要填**：compose 会用下面的 POSTGRES_* 自动拼出
# postgresql+asyncpg://用户:口令@postgres:5432/库名，避免口令写两处导致不一致。
# 只有脱离 compose 部署（云托管 / K8s / 托管数据库）时才需要显式配置，
# 例如：
#   REEL_DATABASE__URL=postgresql+asyncpg://reelagent:口令@db.internal:5432/reelagent?ssl=require
REEL_DATABASE__URL=postgresql+asyncpg://reelagent:CHANGE_ME_同_POSTGRES_PASSWORD@postgres:5432/reelagent

# 连接池：api 副本数 × POOL_SIZE + worker 副本数 × POOL_SIZE 必须小于
# 数据库的 max_connections（自建 Postgres 默认 100），否则高峰期会"连接被拒"。
REEL_DATABASE__POOL_SIZE=10
REEL_DATABASE__MAX_OVERFLOW=20
# 必须小于云数据库的空闲连接回收时间，否则会偶发 "server closed the connection"
REEL_DATABASE__POOL_RECYCLE=1800
REEL_DATABASE__POOL_PRE_PING=true
# 单条 SQL 服务端超时，防止慢查询占满连接池
REEL_DATABASE__STATEMENT_TIMEOUT_MS=30000


# ============================================================================
# 三、Redis（生产建议启用）
# ============================================================================
# 单副本时可以关掉（限流退化为进程内计数）；多副本**必须**开，
# 否则每个副本各算一份额度，等于限流失效。
# 同样地，compose 会用 REDIS_PASSWORD 推导 REEL_REDIS__URL，无需重复填写。
REEL_REDIS__ENABLED=true
REEL_REDIS__URL=redis://:CHANGE_ME_同_REDIS_PASSWORD@redis:6379/0
REEL_REDIS__SOCKET_TIMEOUT=2.0
REEL_REDIS__MAX_CONNECTIONS=32


# ============================================================================
# 四、对象存储（决定成片存哪、能不能横向扩容）
# ============================================================================
# 【推荐】生产用 s3：api 与 worker 不再需要共享磁盘，扩容/迁移都简单，
#       下载走预签名 URL，不占应用带宽。
# 【可行】local：单机 + 共享卷也能跑，但换机器就得搬数据。
REEL_STORAGE__BACKEND=local
# local 后端的目录（compose 里挂的是 artifacts 卷 → /app/workspace）
REEL_STORAGE__LOCAL_DIR=/app/workspace/storage
# 切到 s3 时取消下面注释并填值（backend=s3 但桶名为空会直接报错）：
# REEL_STORAGE__BACKEND=s3
# REEL_STORAGE__S3_BUCKET=reelagent-prod
# REEL_STORAGE__S3_REGION=ap-southeast-1
# REEL_STORAGE__S3_ENDPOINT_URL=                 # R2/MinIO 才需要
# REEL_STORAGE__S3_ACCESS_KEY_ID=                 # 云上建议留空，改用实例角色
# REEL_STORAGE__S3_SECRET_ACCESS_KEY=
# REEL_STORAGE__S3_PUBLIC_BASE_URL=https://cdn.example.com
# REEL_STORAGE__PRESIGN_TTL_SECONDS=3600
REEL_STORAGE__MAX_UPLOAD_MB=32


# ============================================================================
# 五、可观测性（生产排障全靠它）
# ============================================================================
# 采集友好：json 格式便于 Loki/ELK 解析；本地看日志才用 console
REEL_OBSERVABILITY__LOG_FORMAT=json
REEL_OBSERVABILITY__LOG_LEVEL=INFO
REEL_OBSERVABILITY__METRICS_ENABLED=true
REEL_OBSERVABILITY__SLOW_REQUEST_MS=3000
# 强烈建议配置：线上异常的堆栈靠它，否则只能看日志猜
# REEL_OBSERVABILITY__SENTRY_DSN=https://xxx@o000000.ingest.sentry.io/0000000


# ============================================================================
# 六、Worker（按机器规格调）
# ============================================================================
# 并发上限的经验值：机器核数 / 2，再结合供应商限流往下压。
# 容器里还要考虑内存：ffmpeg 合成一个 1080p 成片峰值可到 1GB 上下。
REEL_WORKER__CONCURRENCY=2
REEL_WORKER__SHOT_CONCURRENCY=3
REEL_WORKER__LEASE_SECONDS=900
REEL_WORKER__HEARTBEAT_SECONDS=20
REEL_WORKER__JOB_TIMEOUT_SECONDS=3600
REEL_WORKER__MAX_ATTEMPTS=3
# ⚠ 停机宽限期：compose 的 stop_grace_period 必须大于它
#   （docker-compose.yml 已设为 120s；K8s 见 deploy/k8s/deployment-worker.yaml）
REEL_WORKER__SHUTDOWN_GRACE_SECONDS=60


# ============================================================================
# 七、限流与安全策略
# ============================================================================
REEL_RATE_LIMIT__ENABLED=true
REEL_RATE_LIMIT__ANONYMOUS_PER_MINUTE=30
REEL_RATE_LIMIT__USER_PER_MINUTE=240
# 建项目是花钱最多的接口，公开上线时建议再压到 10~20
REEL_RATE_LIMIT__PROJECT_CREATES_PER_HOUR=20
REEL_RATE_LIMIT__API_KEY_PER_MINUTE=300
REEL_SECURITY__LOGIN_MAX_ATTEMPTS=10
REEL_SECURITY__LOGIN_WINDOW_SECONDS=300
REEL_SECURITY__MIN_PASSWORD_LENGTH=10
# 公开上线建议先关掉公开注册，改邀请制，避免被刷额度
REEL_SECURITY__ALLOW_SIGNUP=false
REEL_SECURITY__SIGNUP_INVITE_CODE=CHANGE_ME_你的邀请码


# ============================================================================
# 八、计费（Stripe，可选）
# ============================================================================
# 启用后必须同时填 secret_key（否则配置校验报错）。
# Webhook 地址要在 Stripe 后台配置为：https://你的域名/webhooks/stripe
# 并且必须填 webhook_secret —— 否则任何人都能伪造"充值成功"的请求。
REEL_BILLING__ENABLED=false
# REEL_BILLING__SECRET_KEY=sk_live_xxx
# REEL_BILLING__WEBHOOK_SECRET=whsec_xxx
# REEL_BILLING__PUBLISHABLE_KEY=pk_live_xxx
# REEL_BILLING__CURRENCY=cny
# REEL_BILLING__PRICE_STARTER=price_xxx
# REEL_BILLING__PRICE_PRO=price_xxx
# REEL_BILLING__PRICE_STUDIO=price_xxx
# 加价倍率：3.0 表示按供应商成本的 3 倍向用户扣点
# REEL_BILLING__MARKUP_MULTIPLIER=3.0
# REEL_BILLING__CREDITS_PER_USD=100


# ============================================================================
# 九、其余供应商（LLM / 图像 / TTS）
# ============================================================================
# 建议逐个显式配置：只配视频能出片，但没有 LLM 就写不出分镜，没有 TTS 就没有配音。
REEL_PROVIDERS__LLM__PROVIDER=deepseek
REEL_PROVIDERS__LLM__MODEL=deepseek-chat
REEL_PROVIDERS__LLM__API_KEY=CHANGE_ME_你的LLM_Key
REEL_PROVIDERS__LLM__BASE_URL=https://api.deepseek.com/v1

REEL_PROVIDERS__IMAGE__PROVIDER=ark
REEL_PROVIDERS__IMAGE__MODEL=doubao-seedream-4-0-250828
REEL_PROVIDERS__IMAGE__API_KEY=CHANGE_ME_你的图像Key
REEL_PROVIDERS__IMAGE__BASE_URL=https://ark.cn-beijing.volces.com/api/v3

REEL_PROVIDERS__VIDEO__PROVIDER=ark
REEL_PROVIDERS__VIDEO__MODEL=doubao-seedance-1-0-pro-250528
REEL_PROVIDERS__VIDEO__API_KEY=CHANGE_ME_你的视频Key
REEL_PROVIDERS__VIDEO__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视频生成慢，超时给足；并发压低避免触发厂商限流把整单拖垮
REEL_PROVIDERS__VIDEO__TIMEOUT_SECONDS=300
REEL_PROVIDERS__VIDEO__MAX_CONCURRENCY=2

REEL_PROVIDERS__TTS__PROVIDER=dashscope
REEL_PROVIDERS__TTS__MODEL=qwen3-tts-flash
REEL_PROVIDERS__TTS__API_KEY=CHANGE_ME_你的TTS_Key
REEL_PROVIDERS__TTS__BASE_URL=https://dashscope.aliyuncs.com/api/v1

# BYOK：允许用户填自己的 Key。自用/私有部署建议 false，走平台统一计费时保持 true
REEL_PROVIDERS__ALLOW_BYOK=true


# ============================================================================
# 十、Compose 变量（docker-compose.yml 读取，不属于 config.py）
# ============================================================================
# 口令只在这里写一次，compose 会推导出应用的数据库/Redis 连接串。
# 强烈建议用随机口令：
#     openssl rand -base64 24
POSTGRES_USER=reelagent
# ⚠ CHANGE_ME ⑧
POSTGRES_PASSWORD=CHANGE_ME_强口令_至少24位随机
POSTGRES_DB=reelagent
# ⚠ CHANGE_ME ⑨
REDIS_PASSWORD=CHANGE_ME_另一个强口令

# 绑定与端口：默认只绑 127.0.0.1，前面必须有反向代理做 TLS
REEL_BIND_ADDR=127.0.0.1
REEL_HTTP_PORT=8000
REEL_IMAGE=reelagent
REEL_IMAGE_TAG=local
REDIS_MAXMEMORY=256mb


# ============================================================================
# 附：启动校验清单（触发条件 REEL_ENV=prod）
# ============================================================================
# 下面这段是**实测结果**（用空配置 + REEL_ENV=prod 跑 get_settings() 复现过），
# 不是照代码猜的。
#
# A. 会真的拦住启动的检查（实测报错原文）：
#   - 生产环境不应使用 SQLite，请配置 REEL_DATABASE__URL
#       —— SQLite 单写入者模型撑不住 worker 的并发抢占与租约续约。
#   - 生产环境必须开启 REEL_SECURITY__HTTPS_ONLY=true
#       —— 否则会话 Cookie 会以明文在 HTTP 上传输。
#   - 生产环境必须显式配置 REEL_SECURITY__ALLOWED_HOSTS
#       —— 通配 "*" 会让 Host 头可伪造（缓存投毒 / 密码重置链接劫持）。
#   - 生产环境 REEL_BASE_URL 必须是 https
#       —— 回调地址、分享链接都会带上它，http 会泄漏并降级安全。
#   - 未配置任何视频供应商 Key（REEL_PROVIDERS__VIDEO__API_KEY）
#       —— 没 Key 就产不出成片，属于"上线即不可用"。
#
# B. 另外两条由嵌套模型触发（同样是硬失败）：
#   - REEL_STORAGE__BACKEND=s3 时必须配置 REEL_STORAGE__S3_BUCKET；
#   - REEL_BILLING__ENABLED=true 时必须配置 REEL_BILLING__SECRET_KEY。
#
# C. ⚠ 有一条检查**名存实亡，千万别依赖它**（已实测确认）：
#   config.py 里写的 "生产环境 REEL_SECURITY__SECRET_KEY 未配置 → 拒绝启动"
#   实际上永远不会触发。原因是 SecuritySettings 的 `_derive` 校验器先跑，
#   发现 secret_key 为空就 `secrets.token_urlsafe(48)` 自动生成了一个随机值，
#   于是父级 Settings 再检查时它已经"非空"了。
#
#   后果（生产上很致命，务必手工确认这一项）：
#     * 每个进程一份随机密钥 → 多副本 api 之间的会话互相不认，
#       用户在负载均衡后面会"随机掉登录"；
#     * 每次重启/重新部署密钥都会变 → 全站用户被登出；
#     * 反过来说，攻击者拿到一份进程内存也不能伪造签名（这点是好的），
#       但"会话不稳定"本身已经足够让产品不可用。
#
#   所以：**上线前请人工确认 .env 里 REEL_SECURITY__SECRET_KEY 有值**，
#   不要指望启动校验替你发现。
#
# 自检命令（改完配置先跑一下，比等容器起不来再看日志快得多）：
#     docker compose run --rm --entrypoint python migrate \
#       -c "from reelagent_cloud.config import get_settings; print(get_settings().safe_dump())"
#   safe_dump() 里所有密钥已打码，可以安全贴进工单/群里。
#
# 非生产环境（dev/staging）不校验上述 A/B 项，并且会在 secret_key 为空时
# 自动生成、自动派生 api_key_pepper，保证 clone 下来就能跑。
